POSTGRES_DB=sync
POSTGRES_USER=sync
POSTGRES_PASSWORD=sync

SYNC_APP_HOST=0.0.0.0
SYNC_APP_PORT=8000
SYNC_LOG_LEVEL=info
SYNC_DEBUG=false

SYNC_DATABASE_URL=postgresql+asyncpg://sync:sync@postgres:5432/sync
SYNC_DATABASE_POOL_SIZE=5
SYNC_DATABASE_MAX_OVERFLOW=10

SYNC_SCHEDULE_ENABLED=true
SYNC_SCHEDULE_INTERVAL_SECONDS=300
SYNC_CELERY_BROKER_URL=redis://redis:6379/0

SYNC_SYSTEM_A_BASE_URL=http://system-a:8000
SYNC_SYSTEM_B_BASE_URL=http://system-b:8000
SYNC_EXTERNAL_API_TIMEOUT_SECONDS=5
SYNC_EXTERNAL_API_MAX_RETRIES=3
SYNC_EXTERNAL_API_RETRY_DELAY_SECONDS=0.2
