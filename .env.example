POSTGRES_DB=sync
POSTGRES_USER=sync
POSTGRES_PASSWORD=sync

SYNC_APP_HOST=0.0.0.0
SYNC_APP_PORT=8000
SYNC_LOG_LEVEL=info
SYNC_DEBUG=false

SYNC_DATABASE_URL=postgresql+asyncpg://sync:sync@postgres:5432/sync
SYNC_DATABASE_POOL_SIZE=5
SYNC_DATABASE_MAX_OVERFLOW=10

SYNC_SCHEDULE_ENABLED=true
SYNC_SCHEDULE_ON_START=false
SYNC_SCHEDULE_INTERVAL_SECONDS=300
SYNC_WORKER_POLL_INTERVAL_SECONDS=1

SYNC_SYSTEM_A_BASE_URL=http://127.0.0.1:8000/mock/system-a
SYNC_SYSTEM_B_BASE_URL=http://127.0.0.1:8000/mock/system-b
SYNC_EXTERNAL_API_TIMEOUT_SECONDS=5
SYNC_EXTERNAL_API_MAX_RETRIES=3
SYNC_EXTERNAL_API_RETRY_DELAY_SECONDS=0.2

# Failure injection for demonstrating error handling:
SYNC_MOCK_SYSTEM_A_FAIL=false
SYNC_MOCK_SYSTEM_B_FAIL_IDS=
